local T = require("../../../../roblox/tests/harness/Test")
local describe, it, expect = T.describe, T.it, T.expect

local F = require("./KingdomFixtures")
local Diplomacy = require("@game/ReplicatedStorage/Game/Sim/Diplomacy")
local Military = require("@game/ReplicatedStorage/Game/Sim/Military")
local WarWatch = require("@game/ReplicatedStorage/Game/Sim/WarWatch")

-- crimson at the origin, azure 300 studs east, at war or not as each test says; no citizens (units fight undisturbed)
local function world()
	local sim, k1 = F.kingdom({ nodes = false, tuning = { startCitizens = {}, birthInterval = 1e6 } })
	local k2 = sim:addKingdom({ id = "azure", name = "Rival", x = 300, z = 0 })
	local k3 = sim:addKingdom({ id = "emerald", name = "Third", x = 0, z = 300 })
	Military.install(sim)
	assert(sim:addRuler("crimson", 101))
	F.events(sim)
	return sim, k1, k2, k3
end

local function named(sim, name: string): { any }
	return F.events(sim, name)
end

describe("Sim/WarWatch: sieges (G9 SiegeChanged)", function()
	it("starts with the first enemy hit on a keep, once, and ends after 20 quiet seconds", function()
		local sim, k1 = world()
		local keep = sim.buildings[k1.keepId]
		WarWatch.keepHit(sim, keep, "azure")
		WarWatch.keepHit(sim, keep, "azure")
		sim:advance(1)
		local started = named(sim, "SiegeChanged")
		expect(#started).toBe(1)
		expect(started[1].on).toBe(true)
		expect(started[1].kingdomId).toBe("crimson")
		expect(started[1].buildingId).toBe(k1.keepId)
		expect(started[1].byKingdomIds).toEqual({ "azure" })
		sim:advance(15)
		WarWatch.keepHit(sim, keep, "emerald") -- another attacker joins; the quiet spell restarts
		sim:advance(15)
		expect(#named(sim, "SiegeChanged")).toBe(0)
		sim:advance(6)
		local ended = named(sim, "SiegeChanged")
		expect(#ended).toBe(1)
		expect(ended[1].on).toBe(false)
		expect(ended[1].byKingdomIds).toEqual({ "azure", "emerald" })
		-- a later attack is a new siege
		WarWatch.keepHit(sim, keep, "azure")
		sim:advance(0.25)
		expect(#named(sim, "SiegeChanged")).toBe(1)
	end)

	it("counts only enemy hits on a keep: not other buildings, not the owner's own", function()
		local sim, k1 = world()
		local house = sim:_createBuilding(k1, "house", 40, 40)
		WarWatch.keepHit(sim, house, "azure")
		WarWatch.keepHit(sim, sim.buildings[k1.keepId], "crimson")
		sim:advance(1)
		expect(#named(sim, "SiegeChanged")).toBe(0)
	end)

	it("is started by a real ram blow on the keep", function()
		local sim, k1, k2 = world()
		Diplomacy.setRelation(sim, "crimson", "azure", "War")
		Military.spawnUnit(sim, k2, "ram", 14 + 5, 0).order = { kind = "Attack", kingdomId = "crimson" }
		F.events(sim)
		sim:advance(3)
		local siege = named(sim, "SiegeChanged")
		expect(#siege >= 1).toBe(true)
		expect(siege[1].on).toBe(true)
		expect(siege[1].byKingdomIds).toEqual({ "azure" })
		expect(sim.buildings[k1.keepId].hp < sim.buildings[k1.keepId].maxHp).toBe(true)
	end)

	it("ends nothing when the kingdom falls: no end event, and the state is dropped", function()
		local sim, k1 = world()
		WarWatch.keepHit(sim, sim.buildings[k1.keepId], "azure")
		sim:advance(0.25)
		F.events(sim)
		Military.eliminate(sim, k1, "azure")
		sim:advance(40)
		expect(#named(sim, "SiegeChanged")).toBe(0)
		expect(sim.warWatch.crimson).toBeNil()
	end)
end)

describe("Sim/WarWatch: raids (G9 RaidChanged)", function()
	it("starts when threats appear (count, attackers, centroid), ends after 10 quiet seconds, once each", function()
		local sim, k1, k2, k3 = world()
		Diplomacy.setRelation(sim, "crimson", "azure", "War")
		Diplomacy.setRelation(sim, "crimson", "emerald", "War")
		local a = Military.spawnUnit(sim, k2, "soldier", 60, 0)
		local b = Military.spawnUnit(sim, k3, "soldier", 60, 40)
		a.order, b.order = { kind = "Hold" }, { kind = "Hold" }
		F.events(sim)
		sim:advance(0.25)
		sim:advance(2)
		local raids = named(sim, "RaidChanged")
		expect(#raids).toBe(1)
		expect(raids[1].on).toBe(true)
		expect(raids[1].kingdomId).toBe("crimson")
		expect(raids[1].count).toBe(2)
		expect(raids[1].byKingdomIds).toEqual({ "azure", "emerald" })
		expect(raids[1].position.x).toBe(60)
		expect(raids[1].position.z).toBe(20)
		-- they leave: nothing for 9 s, then one end
		a.alive, b.alive = true, true
		Diplomacy.setRelation(sim, "crimson", "azure", "Peace")
		Diplomacy.setRelation(sim, "crimson", "emerald", "Peace")
		sim:advance(9)
		expect(#named(sim, "RaidChanged")).toBe(0)
		sim:advance(2)
		local ended = named(sim, "RaidChanged")
		expect(#ended).toBe(1)
		expect(ended[1].on).toBe(false)
		expect(sim.warWatch.crimson.raid).toBeNil()
		expect(#k1.threats).toBe(0)
	end)

	it("a short gap does not end the raid, and the other kingdom (azure) hears nothing", function()
		local sim, _, k2 = world()
		Diplomacy.setRelation(sim, "crimson", "azure", "War")
		local a = Military.spawnUnit(sim, k2, "soldier", 60, 0)
		a.order = { kind = "Hold" }
		F.events(sim)
		sim:advance(2)
		expect(#named(sim, "RaidChanged")).toBe(1)
		a.x = 250 -- out of crimson's territory for 5 s, then back
		sim:advance(5)
		a.x = 60
		sim:advance(15)
		expect(#named(sim, "RaidChanged")).toBe(0)
	end)

	it("a kingdom that falls mid-raid ends nothing", function()
		local sim, k1, k2 = world()
		Diplomacy.setRelation(sim, "crimson", "azure", "War")
		Military.spawnUnit(sim, k2, "soldier", 60, 0).order = { kind = "Hold" }
		sim:advance(2)
		F.events(sim)
		Military.eliminate(sim, k1, "azure")
		sim:advance(30)
		expect(#named(sim, "RaidChanged")).toBe(0)
	end)
end)
