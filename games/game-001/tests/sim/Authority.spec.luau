local T = require("../../../../roblox/tests/harness/Test")
local describe, it, expect = T.describe, T.it, T.expect

local F = require("./KingdomFixtures")
local Authority = require("@game/ReplicatedStorage/Game/Sim/Authority")
local Commands = require("@game/ReplicatedStorage/Game/Sim/Commands")
local Diplomacy = require("@game/ReplicatedStorage/Game/Sim/Diplomacy")
local Military = require("@game/ReplicatedStorage/Game/Sim/Military")

local A, B, C, RIVAL = 101, 102, 103, 201 -- A, B, C rule crimson (in that order); RIVAL rules azure

-- Two kingdoms, grace 10 s. `late` rulers are seated after the sim started (Founding underway).
local function setup(extra: { number }?)
	local sim, crimson = F.kingdom({ nodes = false, tuning = { startCitizens = {}, birthInterval = 1e6 } })
	sim:addKingdom({ id = "azure", name = "Rival", x = 300, z = 0 })
	sim:addKingdom({ id = "emerald", name = "Third", x = 0, z = 300 })
	Military.install(sim)
	Diplomacy.install(sim, { graceSeconds = 10 })
	assert(sim:addRuler("crimson", A))
	assert(sim:addRuler("crimson", B))
	assert(sim:addRuler("azure", RIVAL))
	for _, userId in extra or {} do
		assert(sim:addRuler("crimson", userId))
	end
	sim:advance(10)
	F.events(sim)
	return sim, crimson
end

local function run(sim, userId: number, name: string, ...: any)
	return Commands.execute(sim, userId, name, ...)
end

describe("Sim/Authority: senior ruler", function()
	it("the longest-seated ruler is senior, in join order, even when seated on the same tick", function()
		local sim, crimson = setup()
		expect(Authority.seniorOf(sim, crimson)).toBe(A)
		expect(Authority.seniorOf(sim, sim.kingdoms.azure)).toBe(RIVAL)
	end)

	it("only the senior declares war and accepts peace; any ruler proposes peace", function()
		local sim = setup()
		local ok, err, result = run(sim, A, "DeclareWar", "azure")
		expect(err).toBeNil()
		expect(ok).toBe(true)
		expect(result.outcome).toBe("declared")
		expect(run(sim, B, "ProposePeace", "azure")).toBe(true)
		-- azure's lone ruler accepts; crimson's non-senior cannot accept a proposal made to crimson
		expect(run(sim, RIVAL, "ProposePeace", "crimson")).toBe(true)
		local ok2, err2 = run(sim, B, "AcceptPeace", "azure")
		expect(ok2).toBe(false)
		expect(err2).toBe("not_senior")
		expect((run(sim, A, "AcceptPeace", "azure"))).toBe(true)
	end)

	it("AI governors (by = nil) are exempt", function()
		local sim = setup()
		local ok = Commands.executeFor(sim, sim.kingdoms.crimson, nil, "DeclareWar", "azure")
		expect(ok).toBe(true)
	end)

	it("a senior who leaves hands over; coming back makes them the newest", function()
		local sim, crimson = setup({ C })
		sim:removeRuler(A)
		expect(Authority.seniorOf(sim, crimson)).toBe(B)
		assert(sim:addRuler("crimson", A))
		expect(Authority.seniorOf(sim, crimson)).toBe(B)
		sim:removeRuler(B)
		expect(Authority.seniorOf(sim, crimson)).toBe(C)
	end)

	it("an idle senior yields to the next active ruler until they act again", function()
		local sim, crimson = setup()
		sim:advance(60)
		sim:touchRuler(B)
		sim:advance(40) -- A idle 100 s (>= 90), B 40 s
		expect(Authority.seniorOf(sim, crimson)).toBe(B)
		sim:touchRuler(A)
		expect(Authority.seniorOf(sim, crimson)).toBe(A)
	end)

	it("a lone ruler, or every ruler idle, keeps seniority", function()
		local sim, crimson = setup()
		sim:advance(500)
		expect(Authority.seniorOf(sim, crimson)).toBe(A)
		sim:removeRuler(B)
		expect(Authority.seniorOf(sim, crimson)).toBe(A)
	end)

	it("a command counts as activity", function()
		local sim, crimson = setup()
		sim:advance(80)
		run(sim, B, "SetJobQuota", "farmer", 1)
		sim:advance(20)
		expect(Authority.seniorOf(sim, crimson)).toBe(B)
	end)
end)

describe("Sim/Authority: asking for war", function()
	it("a non-senior's DeclareWar is an ask: no war, a WarAsked event for the senior", function()
		local sim = setup()
		local ok, err, result = run(sim, B, "DeclareWar", "azure")
		expect(err).toBeNil()
		expect(ok).toBe(true)
		expect(result.outcome).toBe("asked")
		expect(sim:atWar("crimson", "azure")).toBe(false)
		local asked = F.events(sim, "WarAsked")
		expect(#asked).toBe(1)
		expect(asked[1].requester).toBe(B)
		expect(asked[1].seniorId).toBe(A)
		expect(asked[1].target).toBe("azure")
	end)

	it("an ask is validated like a declaration", function()
		local sim = setup()
		expect(select(2, run(sim, B, "DeclareWar", "nowhere"))).toBe("unknown_kingdom")
		run(sim, A, "DeclareWar", "azure")
		expect(select(2, run(sim, B, "DeclareWar", "azure"))).toBe("already_at_war")
	end)

	it("the same ask again refreshes it without a second notice; the cooldown spaces new asks", function()
		local sim = setup()
		run(sim, B, "DeclareWar", "azure")
		run(sim, B, "DeclareWar", "azure")
		expect(#F.events(sim, "WarAsked")).toBe(1)
		expect(#Authority.asks(sim, "crimson")).toBe(1)
	end)

	it("a requester's new asks (another target) are spaced by the ask cooldown", function()
		local sim = setup()
		run(sim, B, "DeclareWar", "azure")
		run(sim, B, "DeclareWar", "emerald") -- inside the 30 s cooldown: nothing new reaches the senior
		expect(#F.events(sim, "WarAsked")).toBe(1)
		sim:advance(31)
		local _, _, result = run(sim, B, "DeclareWar", "emerald")
		expect(result.delivered).toBe(true)
		expect(#F.events(sim, "WarAsked")).toBe(1)
	end)

	it("at most maxAsks asks stay open; the oldest makes room", function()
		local sim = setup({ C })
		sim.catalog.tuning.rulers.askCooldownSeconds = 0
		sim.catalog.tuning.rulers.maxAsks = 2
		run(sim, B, "DeclareWar", "azure")
		run(sim, B, "DeclareWar", "emerald")
		run(sim, C, "DeclareWar", "azure")
		local asks = Authority.asks(sim, "crimson")
		expect(#asks).toBe(2)
		expect(asks[1].target).toBe("emerald")
		expect(asks[2].from).toBe(C)
	end)

	it("asks expire after askSeconds and the senior's declaration clears them", function()
		local sim = setup()
		run(sim, B, "DeclareWar", "azure")
		sim:advance(59)
		expect(#Authority.asks(sim, "crimson")).toBe(1)
		sim:advance(2)
		expect(#Authority.asks(sim, "crimson")).toBe(0)
		run(sim, B, "DeclareWar", "azure")
		run(sim, A, "DeclareWar", "azure")
		expect(#Authority.asks(sim, "crimson")).toBe(0)
	end)

	it("a requester who leaves takes their asks with them", function()
		local sim = setup()
		run(sim, B, "DeclareWar", "azure")
		sim:removeRuler(B)
		expect(#Authority.asks(sim, "crimson")).toBe(0)
	end)
end)

describe("Sim/Authority: newcomer lock", function()
	it("rulers seated before the first tick are exempt", function()
		local sim = setup()
		expect(Authority.lockedUntil(sim, A)).toBeNil()
		expect(Authority.lockedUntil(sim, B)).toBeNil()
	end)

	it("a ruler seated after Founding began cannot declare, accept or move for 120 s", function()
		local sim, crimson = setup()
		sim:removeRuler(A)
		sim:removeRuler(B)
		assert(sim:addRuler("crimson", C)) -- active, time 10: late
		expect(Authority.lockedUntil(sim, C)).toBe(sim.time + 120)
		expect(select(2, run(sim, C, "DeclareWar", "azure"))).toBe("newcomer_lock")
		expect(select(2, run(sim, C, "AcceptPeace", "azure"))).toBe("newcomer_lock")
		local id = next(crimson.buildingIds)
		expect(select(2, run(sim, C, "MoveBuilding", id, 0, 0, 0))).toBe("newcomer_lock")
		-- everything else still works
		expect((run(sim, C, "SetJobQuota", "farmer", 1))).toBe(true)
		sim:advance(121)
		expect(Authority.lockedUntil(sim, C)).toBeNil()
		expect((run(sim, C, "DeclareWar", "azure"))).toBe(true)
	end)

	it("a ruler seated while the sim is idle (Lobby) is exempt", function()
		local sim = setup()
		sim.active = false
		assert(sim:addRuler("crimson", C))
		expect(Authority.lockedUntil(sim, C)).toBeNil()
	end)
end)
