			end
			if not (d.repeat_decay > 0 and d.repeat_decay <= 1) or d.repeat_window_s < 0 then
				error(`decision {id}: repeat_decay must be in (0, 1] and repeat_window_s >= 0`)
			end
			for _, c in CATEGORIES do
				local v = d.rep[c]
				if type(v) ~= "number" or v < -10 or v > 10 then
					error(`decision {id}: rep.{c} = {tostring(v)} outside -10..10`)
				end
			end
			expect(count(d.rep)).toBe(#CATEGORIES)
			for _, bag in { d.cost, d.resources } do
				for res, n in bag do
					if not RESOURCES[res] or type(n) ~= "number" then
						error(`decision {id}: bad resource entry {tostring(res)}`)
					end
				end
			end
			for res, n in d.cost do
				if n <= 0 then
					error(`decision {id}: cost.{res} must be > 0 (amount paid)`)
				end
			end
			if d.audience ~= "none" and d.audience ~= "occupation" and d.audience ~= "kingdom" then
				error(`decision {id}: unknown audience {tostring(d.audience)}`)
			end
			for traitId in d.trait_overrides do
				if Traits[traitId] == nil then
					error(`decision {id}: trait_overrides names unknown trait {traitId}`)
				end
			end
			for _, cid in d.consequences do
				if Consequences[cid] == nil then
					error(`decision {id}: unknown consequence {cid}`)
				end
			end
			local e = ContentQuery.decisionEffects(id)
			assert(e, id)
			for _, risk in e.risks do
				expect(risk.chance).toBeLessThan(1)
			end
		end
	end)

	it("give every answer the G13.3 option extras: cost? and fully filled { text, chance } risks?", function()
		local names = { name = "Agnes", ruler = "Ruler", kingdom = "Kingdom", occupation = "Farmer" }
		local seenRisk = false
		for _, sid in Dialogue.order do
			for _, r in Dialogue.scenarios[sid].responses do
				local p = ContentQuery.choicePreview(sid, r.id, names)
				assert(p, `{sid}/{r.id}`)
				for key in p do
					if key ~= "cost" and key ~= "risks" then
						error(`choicePreview({sid}, {r.id}) has a field '{key}' beyond the G13.3 option extras`)
					end
				end
				local d = Decisions[r.decision]
				expect(p.cost == nil).toBe(next(d.cost) == nil)
				-- what ConversationService pays (SPEC §6.5): always a table, {} for a free answer
				local e = ContentQuery.decisionEffects(r.decision)
				assert(e, r.decision)
				expect(e.cost).toEqual(p.cost or {})
				expect(function()
					ContentQuery.choicePreview(sid, r.id, nil :: any)
				end).toThrow("fillNames is required")
				local expected = {}
				for _, cid in d.consequences do
					if Consequences[cid].chance < 1 then
						table.insert(expected, Consequences[cid].chance)
					end
				end
				local risks = ContentQuery.choiceRisks(r.decision, names)
				assert(risks, r.decision)
				expect(#risks).toBe(#expected)
				expect(p.risks == nil).toBe(#expected == 0)
				for i, risk in risks do
					seenRisk = true
					expect(risk.chance).toBe(expected[i])
					if string.find(risk.text, "{", 1, true) or string.find(risk.text, "%d+%%") then
						error(`{r.decision}: risk text '{risk.text}' keeps a placeholder or repeats the odds`)
					end
					expect((p.risks :: any)[i]).toEqual(risk)
				end
			end
		end
		expect(seenRisk).toBe(true)
	end)

	it("keep every consequence well-formed; no strike stops a whole kingdom (model decision 6)", function()
		for _, id in sortedKeys(Consequences) do
			local c = Consequences[id]
			expect(c.id).toBe(id)
			if not CONSEQUENCE_KINDS[c.kind] then
				error(`consequence {id}: unknown kind {tostring(c.kind)}`)
			end
			if not (c.chance > 0 and c.chance <= 1) then
				error(`consequence {id}: chance {c.chance} outside (0, 1]`)
			end
			if c.duration_s < 0 or c.delay_s < 0 then
				error(`consequence {id}: negative duration or delay`)
			end
			local occupation = string.match(c.target, "^occupation:(.+)$")
			local simple = {
				speaker = true,
				family = true,
				friends = true,
				soldiers = true,
				civilians = true,
				kingdom = true,
			}
			if not (simple[c.target] or (occupation and Occupations[occupation])) then
				error(`consequence {id}: unknown target {c.target}`)
			end
			if c.duration_s > MAX_DURATION_S then
				error(`consequence {id}: duration_s {c.duration_s} > {MAX_DURATION_S}`)
			end
			if c.kind == "strike" then
				local target = Occupations[occupation or ""]
				if target == nil or target.job == "soldier" then
					error(`consequence {id}: a strike targets one civilian occupation:<id>, not {c.target}`)
				end
				if c.magnitude > STRIKE_MAX_SHARE or c.duration_s > STRIKE_MAX_DURATION_S then
					error(`consequence {id}: a strike from one decision is at most half an occupation for 120 s`)
				end
			end
			if c.kind == "productivity" and not LOCAL_TARGETS[c.target] and c.magnitude < GROUP_PRODUCTIVITY_FLOOR then
				error(`consequence {id}: productivity {c.magnitude} on {c.target} would stop a whole group`)
			end
			-- FORGE-00 ruling (PR #67 review #2): the panel shows a risk's chance; the text describes the outcome
			if c.notice and string.find(c.notice, "{chance}", 1, true) then
				error(`consequence {id}: a notice never repeats the chance (the conversation panel shows it)`)
			end
			if c.chance < 1 and c.notice == nil then
				error(`consequence {id}: a risk (chance {c.chance}) needs a notice that describes the outcome`)
			end
			if c.notice then
				local filled = ContentQuery.consequenceNotice(
					c,
					{ name = "Agnes", ruler = "Ruler", kingdom = "Kingdom", occupation = "Farmer" }
				)
				if filled == nil or string.find(filled, "{", 1, true) then
					error(`consequence {id}: notice keeps an unfilled placeholder: {tostring(filled)}`)
				end
			end
			if c.kind == "unlock_scenario" and Dialogue.scenarios[c.param] == nil then
				error(`consequence {id}: unlocks unknown scenario {tostring(c.param)}`)
			end
			if c.kind == "cue" and type(c.cue_id) ~= "string" then
				error(`consequence {id}: a cue needs cue_id`)
			end
			if c.notice and textLength(c.notice) > TEXT_LIMITS.notice then
				error(`consequence {id}: notice over its length limit`)
			end
		end
	end)
end)

describe("model decision 6: no single decision turns the kingdom", function()
