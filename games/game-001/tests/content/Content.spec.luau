-- ---------------------------------------------------------------- helpers

local function sortedKeys(t: { [string]: any }): { string }
	local out = {}
	for k in t do
		table.insert(out, k)
	end
	table.sort(out)
	return out
end

local function count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

local function setOf(list: { string }): { [string]: boolean }
	local out = {}
	for _, v in list do
		out[v] = true
	end
	return out
end

local function textLength(s: string): number
	return utf8.len(s) or #s
end

-- Every condition in the library, with where it came from and its scope.
local function allConditions(): { { where: string, clauses: { any }, citizen: boolean } }
	local out = {}
	for _, id in Dialogue.order do
		table.insert(out, { where = `scenario {id} trigger`, clauses = Dialogue.scenarios[id].trigger, citizen = true })
	end
	for i, a in Reputation.actions do
		table.insert(out, { where = `action #{i} ({a.id}) condition`, clauses = a.condition, citizen = false })
		table.insert(out, {
			where = `action #{i} ({a.id}) audience_condition`,
			clauses = a.audience_condition,
			citizen = true,
		})
	end
	return out
end

-- The variable vocabulary of SPEC §4: kind = "number" | "enum" | "flag", and enum values.
local function varSpec(var: string): (string?, { string }?, boolean?)
	local numbers = {
		["kingdom.food"] = true,
		["kingdom.wood"] = true,
		["kingdom.stone"] = true,
		["kingdom.gold"] = true,
		["kingdom.fed_ratio"] = true,
		["kingdom.housing_ratio"] = true,
		["kingdom.happiness"] = true,
		["kingdom.stability"] = true,
		["kingdom.morale"] = true,
		["kingdom.population"] = true,
		["kingdom.soldiers"] = true,
		["kingdom.level.keep"] = true,
	}
	local citizenNumbers = {
		["citizen.loyalty"] = true,
		["citizen.chemistry"] = true,
		["citizen.mood"] = true,
		["citizen.hunger"] = true,
		["citizen.obedience"] = true,
	}
	if numbers[var] then
		return "number", nil, false
	elseif citizenNumbers[var] then
		return "number", nil, true
	elseif var == "occupation" then
		return "enum", sortedKeys(Occupations), true
	elseif var == "phase" then
		return "enum", PHASES, false
	elseif var == "citizen.has_family" or var == "citizen.has_friend" or var == "citizen.has_rival" then
		return "flag", nil, true
	end
	local building = string.match(var, "^kingdom%.count%.(.+)$")
	if building then
		return if table.find(BUILDING_TYPES, building) then "number" else nil, nil, false
	end
	local category = string.match(var, "^rep%.(.+)$")
	if category then
		return if table.find(CATEGORIES, category) then "number" else nil, nil, false
	end
	local traitId = string.match(var, "^citizen%.trait%.(.+)$")
	if traitId then
		return if Traits[traitId] then "flag" else nil, nil, true
	end
	if string.match(var, "^citizen%.memory%.[A-Za-z][A-Za-z0-9_]*$") then
		return "flag", nil, true
	end
	local tag = string.match(var, "^event%.(.+)$")
	if tag then
		return if table.find(EVENT_TAGS, tag) then "flag" else nil, nil, false
	end
	local decisionId = string.match(var, "^decision%.(.+)$")
	if decisionId then
		return if Decisions[decisionId] then "flag" else nil, nil, false
	end
	return nil, nil, nil
end

-- A ctx that sets every variable the library can mention (memories: every tag used anywhere).
local function fullSampleCtx(): { [string]: any }
	local ctx: { [string]: any } = {
		occupation = "farmer",
		phase = "Expansion",
		["kingdom.food"] = 120,
		["kingdom.wood"] = 80,
		["kingdom.stone"] = 40,
		["kingdom.gold"] = 15,
		["kingdom.fed_ratio"] = 0.75,
		["kingdom.housing_ratio"] = 0.95,
		["kingdom.happiness"] = 55,
		["kingdom.stability"] = 60,
		["kingdom.morale"] = 50,
		["kingdom.population"] = 12,
		["kingdom.soldiers"] = 3,
		["kingdom.level.keep"] = 1,
		["citizen.loyalty"] = 50,
		["citizen.chemistry"] = 0,
		["citizen.mood"] = 50,
		["citizen.hunger"] = 0.4,
		["citizen.obedience"] = 50,
		["citizen.has_family"] = true,
		["citizen.has_friend"] = true,
		["citizen.has_rival"] = false,
	}
	for i, b in BUILDING_TYPES do
		ctx[`kingdom.count.{b}`] = i % 3
	end
	for _, c in CATEGORIES do
		ctx[`rep.{c}`] = 50
	end
	for i, traitId in sortedKeys(Traits) do
		ctx[`citizen.trait.{traitId}`] = i % 2 == 0
	end
	for i, tag in EVENT_TAGS do
		ctx[`event.{tag}`] = i % 2 == 1
	end
	for i, decisionId in sortedKeys(Decisions) do
		ctx[`decision.{decisionId}`] = i % 3 == 0
	end
	for _, cond in allConditions() do
		for _, clause in cond.clauses do
			if string.sub(clause.var, 1, 15) == "citizen.memory." then
				ctx[clause.var] = false
			end
		end
	end
	return ctx
end

-- Values that satisfy every clause on each variable, or nil + the variable that cannot be met.
local function satisfyingCtx(clauses: { any }, base: { [string]: any }): ({ [string]: any }?, string?)
	local ctx = table.clone(base)
	local byVar: { [string]: { any } } = {}
	for _, clause in clauses do
		byVar[clause.var] = byVar[clause.var] or {}
		table.insert(byVar[clause.var], clause)
	end
	for _, var in sortedKeys(byVar) do
		local list = byVar[var]
		local candidates: { any } = { true, false, "__other__" }
		local numbers = {}
		for _, clause in list do
			if type(clause.value) == "table" then
				for _, v in clause.value do
					table.insert(candidates, v)
				end
			elseif type(clause.value) == "number" then
				table.insert(numbers, clause.value)
			else
				table.insert(candidates, clause.value)
			end
		end
		for _, n in numbers do
			for _, d in { 0, -1, 1, -0.001, 0.001 } do
				table.insert(candidates, n + d)
			end
			for _, m in numbers do
				table.insert(candidates, (n + m) / 2)
			end
		end
		local found = false
		for _, v in candidates do
			ctx[var] = v
			if ContentQuery.evaluate(list, ctx) then
				found = true
				break
			end
		end
		if not found then
			return nil, var
		end
	end
	return ctx, nil
end

-- ---------------------------------------------------------------- specs

describe("generated content modules (SPEC §7)", function()
	it("are all present with the generated header and load as tables", function()
		for _, name in sortedKeys(MODULES) do
			local path = `{T.root}/{CONTENT_DIR}/{name}.luau`
			if not fs.isFile(path) then
				error(`{CONTENT_DIR}/{name}.luau is missing: run python3 tools/content/content.py build`)
			end
			local source = fs.readFile(path)
			if string.sub(source, 1, #HEADER) ~= HEADER then
				error(`{name}.luau does not start with the GENERATED header`)
			end
			expect(MODULES[name]).toBeA("table")
		end
	end)

	it("bind ContentQuery's module functions to these modules", function()
		expect(ContentQuery.data.dialogue).toBe(Dialogue)
		expect(ContentQuery.data.decisions).toBe(Decisions)
		expect(ContentQuery.data.consequences).toBe(Consequences)
		expect(ContentQuery.data.traits).toBe(Traits)
	end)

	it("are deeply frozen, so no consumer can change the shared content (review finding L6)", function()
		local function walk(value: any, path: string)
			if not table.isfrozen(value) then
				error(`{path} is not frozen`)
			end
			for key, child in value do
				if type(child) == "table" then
					walk(child, `{path}.{tostring(key)}`)
				end
			end
		end
		for _, name in sortedKeys(MODULES) do
			walk(MODULES[name], name)
		end
		local id = Dialogue.order[1]
		expect(function()
			(Dialogue.scenarios[id] :: any).priority = 1
		end).toThrow("readonly")
		expect(function()
			table.insert(Dialogue.order :: any, "extra")
		end).toThrow("readonly")
	end)
end)

describe("Dialogue", function()
	it("lists every scenario exactly once in order, keyed by its own id", function()
		local seen = {}
		for _, id in Dialogue.order do
			if seen[id] then
				error(`scenario {id} appears twice in Dialogue.order`)
			end
			seen[id] = true
			local s = Dialogue.scenarios[id]
			if s == nil then
				error(`Dialogue.order names unknown scenario {id}`)
			end
			expect(s.id).toBe(id)
		end
		expect(count(seen)).toBe(count(Dialogue.scenarios))
		expect(#Dialogue.order).toBeGreaterThan(0)
	end)

	it("gives every scenario a known occupation, sane timing and texts within limits", function()
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			if s.occupation ~= "any" and Occupations[s.occupation] == nil then
				error(`scenario {id}: unknown occupation {s.occupation}`)
			end
			if type(s.priority) ~= "number" or s.priority < 1 or s.priority > 100 then
				error(`scenario {id}: priority {tostring(s.priority)} outside 1-100`)
			end
			if type(s.cooldown_s) ~= "number" or s.cooldown_s < 0 then
				error(`scenario {id}: cooldown_s {tostring(s.cooldown_s)} must be >= 0`)
			end
			expect(s.once_per_citizen).toBeA("boolean")
			expect(s.trigger).toBeA("table")
			if textLength(s.thought) > TEXT_LIMITS.thought or textLength(s.question) > TEXT_LIMITS.question then
				error(`scenario {id}: thought or question over its length limit`)
			end
		end
	end)

	it("gives every scenario and response a contracted icon and tone (CONTRACTS G13.3)", function()
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			if not THOUGHT_ICONS[s.icon] then
				error(`scenario {id}: icon {tostring(s.icon)} is not request, concern or idea`)
			end
			expect(s.locked).toBeA("boolean")
			for _, r in s.responses do
				if not REACTION_TONES[r.tone] then
					error(`response {r.id}: tone {tostring(r.tone)} is not happy, angry, sad or neutral`)
				end
			end
		end
	end)

	it("uses {family}, {friend} and {rival} only where the trigger guarantees that relation", function()
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			local have = {}
			for _, clause in s.trigger do
				if clause.op == "=" and clause.value == true then
					have[clause.var] = true
				end
			end
			local texts = { s.thought, s.question }
			for _, r in s.responses do
				table.insert(texts, r.text)
				table.insert(texts, r.reaction)
			end
			for _, text in texts do
				for name in string.gmatch(text, "{(%w+)}") do
					local flag = RELATION_FLAGS[name]
					if flag and not have[flag] then
						error(`scenario {id}: '\{{name}\}' without {flag} in the trigger`)
					end
				end
			end
		end
	end)

	it("locks exactly the scenarios that an unlock_scenario consequence opens", function()
		local unlockable = {}
		for _, c in Consequences do
			if c.kind == "unlock_scenario" then
				unlockable[c.param] = true
			end
		end
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			if (s.locked == true) ~= (unlockable[id] == true) then
				error(
					`scenario {id}: locked = {tostring(s.locked)}, but unlockable = {tostring(unlockable[id] == true)}`
				)
			end
		end
	end)

	it("gives every scenario 2-4 responses, sorted by order, that reference existing decisions", function()
		local responseIds = {}
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			if #s.responses < 2 or #s.responses > 4 then
				error(`scenario {id}: {#s.responses} responses (2-4 required)`)
			end
			for i, r in s.responses do
				if responseIds[r.id] then
					error(`response id {r.id} is used twice`)
				end
				responseIds[r.id] = true
				if i > 1 and r.order <= s.responses[i - 1].order then
					error(`scenario {id}: responses not strictly sorted by order at {r.id}`)
				end
				if r.order < 1 or r.order > 4 then
					error(`response {r.id}: order {r.order} outside 1-4`)
				end
				if Decisions[r.decision] == nil then
					error(`response {r.id}: decision {tostring(r.decision)} does not exist`)
				end
				if textLength(r.text) > TEXT_LIMITS.response or textLength(r.reaction) > TEXT_LIMITS.reaction then
					error(`response {r.id}: text or reaction over its length limit`)
				end
				expect(ContentQuery.decisionEffects(r.decision)).toBeTruthy()
			end
		end
	end)
end)

describe("presentation (SPEC §5.10)", function()
	local EMOTION, EXPRESSION, GESTURE, DELIVERY =
		setOf(EMOTIONS), setOf(EXPRESSIONS), setOf(GESTURES), setOf(DELIVERIES)
	local FITS = {}
	for tone, emotions in TONE_EMOTIONS do
		FITS[tone] = setOf(emotions)
	end

	-- One line's optional tags: each from the vocabulary, the emotion fitting the tone, the bubble time in range.
	local function checkTags(where: string, line: { [string]: any }, prefix: string, tone: string?)
		local function tag(name: string, allowed: { [string]: boolean })
			local value = line[prefix .. name]
			if value ~= nil and not allowed[value] then
				error(`{where}: {prefix}{name} '{tostring(value)}' is not in the SPEC §5.10 vocabulary`)
			end
		end
		tag("emotion", EMOTION)
		tag("expression", EXPRESSION)
		tag("gesture", GESTURE)
		tag("delivery", DELIVERY)
		local emotion = line[prefix .. "emotion"]
		if emotion ~= nil and tone ~= nil and not FITS[tone][emotion] then
			error(`{where}: emotion '{emotion}' does not fit tone '{tone}'`)
		end
		local bubble = line.bubble_s
		if prefix == "" and bubble ~= nil then
			if type(bubble) ~= "number" or bubble < BUBBLE_S_MIN or bubble > BUBBLE_S_MAX then
				error(`{where}: bubble_s {tostring(bubble)} outside {BUBBLE_S_MIN}..{BUBBLE_S_MAX}`)
			end
			if math.abs(bubble * 10 - math.round(bubble * 10)) > 1e-9 then
				error(`{where}: bubble_s {bubble} has more than one decimal`)
			end
		end
	end

	it("defines the measured vocabulary, every emotion fitting some tone and every cue gesture a known cue", function()
		expect(#EMOTIONS).toBe(20)
		expect(#EXPRESSIONS).toBe(13)
		expect(#GESTURES).toBe(21)
		expect(#DELIVERIES).toBe(15)
		expect(DELIVERY.defiant).toBeNil()
		local fitting = {}
		for _, emotions in TONE_EMOTIONS do
			for _, e in emotions do
				expect(EMOTION[e]).toBe(true)
				fitting[e] = true
			end
		end
		expect(count(fitting)).toBe(#EMOTIONS)
		local cues = setOf(CUE_IDS)
		for gesture, cue in ContentQuery.GESTURE_CUE do
			expect(GESTURE[gesture]).toBe(true)
			expect(cues[cue]).toBe(true)
		end
	end)

	-- Every optional tag of a generated Dialogue module (real or fixture) is well-formed; traits = known trait ids.
	local function checkDialogue(dialogue: any, traits: { [string]: any })
		local URGENCY, MODE = setOf(URGENCIES), setOf(DELIVERY_MODES)
		for _, id in dialogue.order do
			local s = dialogue.scenarios[id] :: any
			local where = `scenario {id}`
			if s.urgency ~= nil and not URGENCY[s.urgency] then
				error(`{where}: urgency '{tostring(s.urgency)}' is not low, normal, high or critical`)
			end
			if s.delivery_mode ~= nil and not MODE[s.delivery_mode] then
				error(`{where}: delivery_mode '{tostring(s.delivery_mode)}' is not ambient or direct`)
			end
			checkTags(where, { bubble_s = s.thought_bubble_s }, "", nil)
			checkTags(where, s, "question_", nil)
			for _, r in s.responses do
				checkTags(`response {r.id}`, r, "", r.tone)
				for band, line in r.bands or {} do
					if band ~= "high" and band ~= "low" then
						error(`response {r.id}: unknown loyalty band '{tostring(band)}'`)
					end
					if type(line.text) ~= "string" or not REACTION_TONES[line.tone] then
						error(`response {r.id}: the {band} band needs a text and a contracted tone`)
					end
					if textLength(line.text) > TEXT_LIMITS.reaction then
						error(`response {r.id}: the {band} reaction is over its length limit`)
					end
					checkTags(`response {r.id} ({band})`, line, "", line.tone)
				end
			end
			local previous = 0
			for _, v in s.variants or {} do
				if type(v.order) ~= "number" or v.order <= previous then
					error(`{where}: variants not strictly sorted by order at {tostring(v.id)}`)
				end
				previous = v.order
				if (v.trait == nil) == (v.cond == nil) then
					error(`{where}: variant {v.id} needs exactly one selector (trait or cond)`)
				end
				if v.trait ~= nil and traits[v.trait] == nil then
					error(`{where}: variant {v.id} names unknown trait {v.trait}`)
				end
				if textLength(v.text) > TEXT_LIMITS.question then
					error(`{where}: variant {v.id} is over the question's length limit`)
				end
				checkTags(`variant {v.id}`, v, "", nil)
			end
		end
	end

	it("gives scenarios, reactions and question variants only well-formed optional tags", function()
		checkDialogue(Dialogue, Traits)
	end)

	it("accepts the generator's full presentation shape (fixture) and catches a tag outside the vocabulary", function()
		-- PresentationDialogue.luau: the generated Dialogue.luau with every presentation column in use
		local fixture = require("./PresentationDialogue") :: any
		local fixtureTraits = { kind = true, cruel = true, brave = true, timid = true, greedy = true, devout = true }
		checkDialogue(fixture, fixtureTraits)
		local s = fixture.scenarios.s_hungry_farmer
		expect(s.urgency).toBe("high")
		expect(s.responses[1].bands.high.emotion).toBe("joy")
		expect(#s.variants).toBe(2)
		-- a copy with an emotion that does not fit its tone is caught (the checker is not vacuous)
		local bad = table.clone(s.responses[1])
		bad.emotion = "anger"
		local broken = table.clone(s)
		broken.responses = { bad }
		expect(function()
			checkDialogue({ order = { "s_hungry_farmer" }, scenarios = { s_hungry_farmer = broken } }, fixtureTraits)
		end).toThrow("emotion 'anger' does not fit tone 'happy'")
	end)

	it("lets ContentQuery present every scenario and reaction of the library", function()
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id] :: any
			expect(ContentQuery.presentation(id)).toBeA("table")
			-- a citizen no variant selects (no traits, empty ctx) gets the scenario's own question
			local plain = ContentQuery.questionFor(id, { traits = {} }, {}) :: any
			if s.variants == nil then
				expect(plain.text).toBe(s.question)
				expect(plain.variantId).toBeNil()
			end
			for _, r in s.responses do
				local base = ContentQuery.reactionFor(r.id, 50) :: any
				expect(base.band).toBe("base")
				expect(base.text).toBe(r.reaction)
				expect(base.tone).toBe(r.tone)
				for _, loyalty in { 0, 100 } do
					local shown = ContentQuery.reactionFor(r.id, loyalty) :: any
					local band = if loyalty >= ContentQuery.LOYALTY_BANDS.high then "high" else "low"
					local line = if r.bands then r.bands[band] else nil
					expect(shown.text).toBe(if line then line.text else r.reaction)
				end
			end
		end
	end)
end)

describe("conditions (SPEC §4)", function()
	it("use only known variables, operators and value types", function()
		for _, cond in allConditions() do
			expect(cond.clauses).toBeA("table")
			for i, clause in cond.clauses do
				local where = `{cond.where} clause {i} ({tostring(clause.var)} {tostring(clause.op)})`
				local kind, enum, citizenScope = varSpec(clause.var)
				if kind == nil then
					error(`{where}: unknown variable`)
				end
				if citizenScope and not cond.citizen then
					error(`{where}: citizen variable in a kingdom-scope condition`)
				end
				if not ContentQuery.OPS[clause.op] then
					error(`{where}: unknown operator`)
				end
				local value = clause.value
				if kind == "flag" then
					if type(value) ~= "boolean" or (clause.op ~= "=" and clause.op ~= "!=") then
						error(`{where}: a flag takes = or != with true/false`)
					end
				elseif clause.op == "in" then
					if type(value) ~= "table" or #value == 0 then
						error(`{where}: 'in' needs a non-empty list`)
					end
					for _, v in value do
						local ok = if kind == "enum" then table.find(enum :: { string }, v) ~= nil else false
						if not ok then
							error(`{where}: 'in' value {tostring(v)} is not a known {clause.var}`)
						end
					end
				elseif kind == "enum" then
					if type(value) ~= "string" or table.find(enum :: { string }, value) == nil then
						error(`{where}: unknown {clause.var} value {tostring(value)}`)
					end
					if clause.op ~= "=" and clause.op ~= "!=" then
						error(`{where}: an enum takes =, != or in`)
					end
				elseif type(value) ~= "number" or value ~= value then
					error(`{where}: a number variable needs a number value`)
				end
			end
		end
	end)

	it("evaluate to a boolean without error against a full sample ctx", function()
		local ctx = fullSampleCtx()
		local outcomes = { [true] = 0, [false] = 0 }
		for _, cond in allConditions() do
			local ok, result = pcall(ContentQuery.evaluate, cond.clauses, ctx)
			if not ok then
				error(`{cond.where}: evaluate errored: {tostring(result)}`)
			end
			if type(result) ~= "boolean" then
				error(`{cond.where}: evaluate returned {typeof(result)}`)
			end
			outcomes[result] += 1
		end
		expect(outcomes[true] + outcomes[false]).toBe(#allConditions())
		-- the same against an empty ctx: absent variables never error either
		for _, cond in allConditions() do
			expect(ContentQuery.evaluate(cond.clauses, {})).toBeA("boolean")
		end
	end)

	it("let every scenario be offered in some situation (no contradictory triggers)", function()
		local base = fullSampleCtx()
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			local start = table.clone(base)
			start.occupation = if s.occupation == "any" then "farmer" else s.occupation
			local ctx, badVar = satisfyingCtx(s.trigger, start)
			if ctx == nil then
				error(`scenario {id}: no value of {tostring(badVar)} satisfies its trigger`)
			end
			local function offered(citizen: any): boolean
				for _, o in ContentQuery.eligibleScenarios(ctx, citizen, 0, {}) do
					if o.id == id then
						return true
					end
				end
				return false
			end
			if not offered({ id = 1, unlocked = { [id] = true } }) then
				error(`scenario {id}: not offered even when its trigger holds`)
			end
			if s.locked and offered({ id = 1 }) then
				error(`scenario {id}: locked, but offered to a citizen it was never unlocked for`)
			end
		end
	end)
end)

describe("Decisions and Consequences", function()
	it("keep every decision within the model's ranges with known references", function()
		for _, id in sortedKeys(Decisions) do
			local d = Decisions[id]
			expect(d.id).toBe(id)
			if type(d.farm_key) ~= "string" or d.farm_key == "" then
