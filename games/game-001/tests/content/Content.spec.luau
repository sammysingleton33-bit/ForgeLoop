-- The generated content library (games/game-001/src/shared/Content, written by
-- tools/content/content.py from games/game-001/content) as the game loads it: every module
-- loads, references resolve, and every condition is well-typed for the runtime ctx that
-- ContentQuery evaluates (content/SPEC.md §4 and §7). Values are not pinned: the user edits them.
local T = require("../../../../roblox/tests/harness/Test")
local describe, it, expect = T.describe, T.it, T.expect

local fs = require("@lune/fs")

local Consequences = require("@game/ReplicatedStorage/Game/Content/Consequences")
local ContentQuery = require("@game/ReplicatedStorage/Game/Content/ContentQuery")
local Decisions = require("@game/ReplicatedStorage/Game/Content/Decisions")
local Dialogue = require("@game/ReplicatedStorage/Game/Content/Dialogue")
local Names = require("@game/ReplicatedStorage/Game/Content/Names")
local Occupations = require("@game/ReplicatedStorage/Game/Content/Occupations")
local Reputation = require("@game/ReplicatedStorage/Game/Content/Reputation")
local Traits = require("@game/ReplicatedStorage/Game/Content/Traits")

local CONTENT_DIR = "games/game-001/src/shared/Content"
local HEADER = "--!strict\n-- GENERATED by tools/content/content.py from games/game-001/content — do not edit\n"
local MODULES = {
	Dialogue = Dialogue,
	Decisions = Decisions,
	Consequences = Consequences,
	Traits = Traits,
	Names = Names,
	Occupations = Occupations,
	Reputation = Reputation,
}

local CATEGORIES = { "compassion", "honor", "competence", "courage", "authority", "fear" }
local RESOURCES = { food = true, wood = true, stone = true, gold = true } -- CONTRACTS G2
local JOBS = { farmer = true, woodcutter = true, miner = true, builder = true, hauler = true, soldier = true }
local BUILDING_TYPES = { -- CONTRACTS G2, plus the additive VS-2 types of G13.5
	"keep",
	"house",
	"farm",
	"storehouse",
	"lumbercamp",
	"quarry",
	"barracks",
	"watchtower",
	"wall",
	"gate",
	"mine",
	"blacksmith",
	"market",
	"infirmary",
	"granary",
	"shrine",
}
local PHASES = { "Lobby", "Founding", "Expansion", "Conflict", "Endgame", "Arena", "Results" }
local EVENT_TAGS = {
	"raid",
	"shortage",
	"keep_upgraded",
	"building_completed",
	"objective_captured",
	"soldiers_recruited",
	"strike",
	"riot",
}
local CONSEQUENCE_KINDS = {
	productivity = true,
	strike = true,
	morale = true,
	happiness = true,
	stability = true,
	loyalty = true,
	resource_over_time = true,
	unlock_scenario = true,
	memory = true,
	desertion_risk = true,
	unrest_pressure = true,
	cue = true,
}
local TEXT_LIMITS = { thought = 48, question = 160, response = 70, reaction = 140, notice = 100 }
local THOUGHT_ICONS = { request = true, concern = true, idea = true } -- CONTRACTS G13.3
local REACTION_TONES = { happy = true, angry = true, sad = true, neutral = true } -- CONTRACTS G13.3
local RELATION_FLAGS = { family = "citizen.has_family", friend = "citizen.has_friend", rival = "citizen.has_rival" }
-- model decision 6 guards (content/SPEC.md §5.4 and §6.6)
local MAX_DURATION_S = 600
local STRIKE_MAX_SHARE = 0.5
local STRIKE_MAX_DURATION_S = 120
local GROUP_PRODUCTIVITY_FLOOR = -0.5
local KINGDOM_LOYALTY_FLOOR = -5
local KINGDOM_STABILITY_FLOOR = -5
local LOCAL_TARGETS = { speaker = true, family = true, friends = true }
local BROAD_TARGETS = { kingdom = true, civilians = true, soldiers = true }

-- ---------------------------------------------------------------- helpers

local function sortedKeys(t: { [string]: any }): { string }
	local out = {}
	for k in t do
		table.insert(out, k)
	end
	table.sort(out)
	return out
end

local function count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

local function textLength(s: string): number
	return utf8.len(s) or #s
end

-- Every condition in the library, with where it came from and its scope.
local function allConditions(): { { where: string, clauses: { any }, citizen: boolean } }
	local out = {}
	for _, id in Dialogue.order do
		table.insert(out, { where = `scenario {id} trigger`, clauses = Dialogue.scenarios[id].trigger, citizen = true })
	end
	for i, a in Reputation.actions do
		table.insert(out, { where = `action #{i} ({a.id}) condition`, clauses = a.condition, citizen = false })
		table.insert(out, {
			where = `action #{i} ({a.id}) audience_condition`,
			clauses = a.audience_condition,
			citizen = true,
		})
	end
	return out
end

-- The variable vocabulary of SPEC §4: kind = "number" | "enum" | "flag", and enum values.
local function varSpec(var: string): (string?, { string }?, boolean?)
	local numbers = {
		["kingdom.food"] = true,
		["kingdom.wood"] = true,
		["kingdom.stone"] = true,
		["kingdom.gold"] = true,
		["kingdom.fed_ratio"] = true,
		["kingdom.housing_ratio"] = true,
		["kingdom.happiness"] = true,
		["kingdom.stability"] = true,
		["kingdom.morale"] = true,
		["kingdom.population"] = true,
		["kingdom.soldiers"] = true,
		["kingdom.level.keep"] = true,
	}
	local citizenNumbers = {
		["citizen.loyalty"] = true,
		["citizen.chemistry"] = true,
		["citizen.mood"] = true,
		["citizen.hunger"] = true,
		["citizen.obedience"] = true,
	}
	if numbers[var] then
		return "number", nil, false
	elseif citizenNumbers[var] then
		return "number", nil, true
	elseif var == "occupation" then
		return "enum", sortedKeys(Occupations), true
	elseif var == "phase" then
		return "enum", PHASES, false
	elseif var == "citizen.has_family" or var == "citizen.has_friend" or var == "citizen.has_rival" then
		return "flag", nil, true
	end
	local building = string.match(var, "^kingdom%.count%.(.+)$")
	if building then
		return if table.find(BUILDING_TYPES, building) then "number" else nil, nil, false
	end
	local category = string.match(var, "^rep%.(.+)$")
	if category then
		return if table.find(CATEGORIES, category) then "number" else nil, nil, false
	end
	local traitId = string.match(var, "^citizen%.trait%.(.+)$")
	if traitId then
		return if Traits[traitId] then "flag" else nil, nil, true
	end
	if string.match(var, "^citizen%.memory%.[A-Za-z][A-Za-z0-9_]*$") then
		return "flag", nil, true
	end
	local tag = string.match(var, "^event%.(.+)$")
	if tag then
		return if table.find(EVENT_TAGS, tag) then "flag" else nil, nil, false
	end
	local decisionId = string.match(var, "^decision%.(.+)$")
	if decisionId then
		return if Decisions[decisionId] then "flag" else nil, nil, false
	end
	return nil, nil, nil
end

-- A ctx that sets every variable the library can mention (memories: every tag used anywhere).
local function fullSampleCtx(): { [string]: any }
	local ctx: { [string]: any } = {
		occupation = "farmer",
		phase = "Expansion",
		["kingdom.food"] = 120,
		["kingdom.wood"] = 80,
		["kingdom.stone"] = 40,
		["kingdom.gold"] = 15,
		["kingdom.fed_ratio"] = 0.75,
		["kingdom.housing_ratio"] = 0.95,
		["kingdom.happiness"] = 55,
		["kingdom.stability"] = 60,
		["kingdom.morale"] = 50,
		["kingdom.population"] = 12,
		["kingdom.soldiers"] = 3,
		["kingdom.level.keep"] = 1,
		["citizen.loyalty"] = 50,
		["citizen.chemistry"] = 0,
		["citizen.mood"] = 50,
		["citizen.hunger"] = 0.4,
		["citizen.obedience"] = 50,
		["citizen.has_family"] = true,
		["citizen.has_friend"] = true,
		["citizen.has_rival"] = false,
	}
	for i, b in BUILDING_TYPES do
		ctx[`kingdom.count.{b}`] = i % 3
	end
	for _, c in CATEGORIES do
		ctx[`rep.{c}`] = 50
	end
	for i, traitId in sortedKeys(Traits) do
		ctx[`citizen.trait.{traitId}`] = i % 2 == 0
	end
	for i, tag in EVENT_TAGS do
		ctx[`event.{tag}`] = i % 2 == 1
	end
	for i, decisionId in sortedKeys(Decisions) do
		ctx[`decision.{decisionId}`] = i % 3 == 0
	end
	for _, cond in allConditions() do
		for _, clause in cond.clauses do
			if string.sub(clause.var, 1, 15) == "citizen.memory." then
				ctx[clause.var] = false
			end
		end
	end
	return ctx
end

-- Values that satisfy every clause on each variable, or nil + the variable that cannot be met.
local function satisfyingCtx(clauses: { any }, base: { [string]: any }): ({ [string]: any }?, string?)
	local ctx = table.clone(base)
	local byVar: { [string]: { any } } = {}
	for _, clause in clauses do
		byVar[clause.var] = byVar[clause.var] or {}
		table.insert(byVar[clause.var], clause)
	end
	for _, var in sortedKeys(byVar) do
		local list = byVar[var]
		local candidates: { any } = { true, false, "__other__" }
		local numbers = {}
		for _, clause in list do
			if type(clause.value) == "table" then
				for _, v in clause.value do
					table.insert(candidates, v)
				end
			elseif type(clause.value) == "number" then
				table.insert(numbers, clause.value)
			else
				table.insert(candidates, clause.value)
			end
		end
		for _, n in numbers do
			for _, d in { 0, -1, 1, -0.001, 0.001 } do
				table.insert(candidates, n + d)
			end
			for _, m in numbers do
				table.insert(candidates, (n + m) / 2)
			end
		end
		local found = false
		for _, v in candidates do
			ctx[var] = v
			if ContentQuery.evaluate(list, ctx) then
				found = true
				break
			end
		end
		if not found then
			return nil, var
		end
	end
	return ctx, nil
end

-- ---------------------------------------------------------------- specs

describe("generated content modules (SPEC §7)", function()
	it("are all present with the generated header and load as tables", function()
		for _, name in sortedKeys(MODULES) do
			local path = `{T.root}/{CONTENT_DIR}/{name}.luau`
			if not fs.isFile(path) then
				error(`{CONTENT_DIR}/{name}.luau is missing: run python3 tools/content/content.py build`)
			end
			local source = fs.readFile(path)
			if string.sub(source, 1, #HEADER) ~= HEADER then
				error(`{name}.luau does not start with the GENERATED header`)
			end
			expect(MODULES[name]).toBeA("table")
		end
	end)

	it("bind ContentQuery's module functions to these modules", function()
		expect(ContentQuery.data.dialogue).toBe(Dialogue)
		expect(ContentQuery.data.decisions).toBe(Decisions)
		expect(ContentQuery.data.consequences).toBe(Consequences)
		expect(ContentQuery.data.traits).toBe(Traits)
	end)
end)

describe("Dialogue", function()
	it("lists every scenario exactly once in order, keyed by its own id", function()
		local seen = {}
		for _, id in Dialogue.order do
			if seen[id] then
				error(`scenario {id} appears twice in Dialogue.order`)
			end
			seen[id] = true
			local s = Dialogue.scenarios[id]
			if s == nil then
				error(`Dialogue.order names unknown scenario {id}`)
			end
			expect(s.id).toBe(id)
		end
		expect(count(seen)).toBe(count(Dialogue.scenarios))
		expect(#Dialogue.order).toBeGreaterThan(0)
	end)

	it("gives every scenario a known occupation, sane timing and texts within limits", function()
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			if s.occupation ~= "any" and Occupations[s.occupation] == nil then
				error(`scenario {id}: unknown occupation {s.occupation}`)
			end
			if type(s.priority) ~= "number" or s.priority < 1 or s.priority > 100 then
				error(`scenario {id}: priority {tostring(s.priority)} outside 1-100`)
			end
			if type(s.cooldown_s) ~= "number" or s.cooldown_s < 0 then
				error(`scenario {id}: cooldown_s {tostring(s.cooldown_s)} must be >= 0`)
			end
			expect(s.once_per_citizen).toBeA("boolean")
			expect(s.trigger).toBeA("table")
			if textLength(s.thought) > TEXT_LIMITS.thought or textLength(s.question) > TEXT_LIMITS.question then
				error(`scenario {id}: thought or question over its length limit`)
			end
		end
	end)

	it("gives every scenario and response a contracted icon and tone (CONTRACTS G13.3)", function()
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			if not THOUGHT_ICONS[s.icon] then
				error(`scenario {id}: icon {tostring(s.icon)} is not request, concern or idea`)
			end
			expect(s.locked).toBeA("boolean")
			for _, r in s.responses do
				if not REACTION_TONES[r.tone] then
					error(`response {r.id}: tone {tostring(r.tone)} is not happy, angry, sad or neutral`)
				end
			end
		end
	end)

	it("uses {family}, {friend} and {rival} only where the trigger guarantees that relation", function()
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			local have = {}
			for _, clause in s.trigger do
				if clause.op == "=" and clause.value == true then
					have[clause.var] = true
				end
			end
			local texts = { s.thought, s.question }
			for _, r in s.responses do
				table.insert(texts, r.text)
				table.insert(texts, r.reaction)
			end
			for _, text in texts do
				for name in string.gmatch(text, "{(%w+)}") do
					local flag = RELATION_FLAGS[name]
					if flag and not have[flag] then
						error(`scenario {id}: '\{{name}\}' without {flag} in the trigger`)
					end
				end
			end
		end
	end)

	it("locks exactly the scenarios that an unlock_scenario consequence opens", function()
		local unlockable = {}
		for _, c in Consequences do
			if c.kind == "unlock_scenario" then
				unlockable[c.param] = true
			end
		end
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			if (s.locked == true) ~= (unlockable[id] == true) then
				error(
					`scenario {id}: locked = {tostring(s.locked)}, but unlockable = {tostring(unlockable[id] == true)}`
				)
			end
		end
	end)

	it("gives every scenario 2-4 responses, sorted by order, that reference existing decisions", function()
		local responseIds = {}
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			if #s.responses < 2 or #s.responses > 4 then
				error(`scenario {id}: {#s.responses} responses (2-4 required)`)
			end
			for i, r in s.responses do
				if responseIds[r.id] then
					error(`response id {r.id} is used twice`)
				end
				responseIds[r.id] = true
				if i > 1 and r.order <= s.responses[i - 1].order then
					error(`scenario {id}: responses not strictly sorted by order at {r.id}`)
				end
				if r.order < 1 or r.order > 4 then
					error(`response {r.id}: order {r.order} outside 1-4`)
				end
				if Decisions[r.decision] == nil then
					error(`response {r.id}: decision {tostring(r.decision)} does not exist`)
				end
				if textLength(r.text) > TEXT_LIMITS.response or textLength(r.reaction) > TEXT_LIMITS.reaction then
					error(`response {r.id}: text or reaction over its length limit`)
				end
				expect(ContentQuery.decisionEffects(r.decision)).toBeTruthy()
			end
		end
	end)
end)

describe("conditions (SPEC §4)", function()
	it("use only known variables, operators and value types", function()
		for _, cond in allConditions() do
			expect(cond.clauses).toBeA("table")
			for i, clause in cond.clauses do
				local where = `{cond.where} clause {i} ({tostring(clause.var)} {tostring(clause.op)})`
				local kind, enum, citizenScope = varSpec(clause.var)
				if kind == nil then
					error(`{where}: unknown variable`)
				end
				if citizenScope and not cond.citizen then
					error(`{where}: citizen variable in a kingdom-scope condition`)
				end
				if not ContentQuery.OPS[clause.op] then
					error(`{where}: unknown operator`)
				end
				local value = clause.value
				if kind == "flag" then
					if type(value) ~= "boolean" or (clause.op ~= "=" and clause.op ~= "!=") then
						error(`{where}: a flag takes = or != with true/false`)
					end
				elseif clause.op == "in" then
					if type(value) ~= "table" or #value == 0 then
						error(`{where}: 'in' needs a non-empty list`)
					end
					for _, v in value do
						local ok = if kind == "enum" then table.find(enum :: { string }, v) ~= nil else false
						if not ok then
							error(`{where}: 'in' value {tostring(v)} is not a known {clause.var}`)
						end
					end
				elseif kind == "enum" then
					if type(value) ~= "string" or table.find(enum :: { string }, value) == nil then
						error(`{where}: unknown {clause.var} value {tostring(value)}`)
					end
					if clause.op ~= "=" and clause.op ~= "!=" then
						error(`{where}: an enum takes =, != or in`)
					end
				elseif type(value) ~= "number" or value ~= value then
					error(`{where}: a number variable needs a number value`)
				end
			end
		end
	end)

	it("evaluate to a boolean without error against a full sample ctx", function()
		local ctx = fullSampleCtx()
		local outcomes = { [true] = 0, [false] = 0 }
		for _, cond in allConditions() do
			local ok, result = pcall(ContentQuery.evaluate, cond.clauses, ctx)
			if not ok then
				error(`{cond.where}: evaluate errored: {tostring(result)}`)
			end
			if type(result) ~= "boolean" then
				error(`{cond.where}: evaluate returned {typeof(result)}`)
			end
			outcomes[result] += 1
		end
		expect(outcomes[true] + outcomes[false]).toBe(#allConditions())
		-- the same against an empty ctx: absent variables never error either
		for _, cond in allConditions() do
			expect(ContentQuery.evaluate(cond.clauses, {})).toBeA("boolean")
		end
	end)

	it("let every scenario be offered in some situation (no contradictory triggers)", function()
		local base = fullSampleCtx()
		for _, id in Dialogue.order do
			local s = Dialogue.scenarios[id]
			local start = table.clone(base)
			start.occupation = if s.occupation == "any" then "farmer" else s.occupation
			local ctx, badVar = satisfyingCtx(s.trigger, start)
			if ctx == nil then
				error(`scenario {id}: no value of {tostring(badVar)} satisfies its trigger`)
			end
			local function offered(citizen: any): boolean
				for _, o in ContentQuery.eligibleScenarios(ctx, citizen, 0, {}) do
					if o.id == id then
						return true
					end
				end
				return false
			end
			if not offered({ id = 1, unlocked = { [id] = true } }) then
				error(`scenario {id}: not offered even when its trigger holds`)
			end
			if s.locked and offered({ id = 1 }) then
				error(`scenario {id}: locked, but offered to a citizen it was never unlocked for`)
			end
		end
	end)
end)

describe("Decisions and Consequences", function()
	it("keep every decision within the model's ranges with known references", function()
		for _, id in sortedKeys(Decisions) do
			local d = Decisions[id]
			expect(d.id).toBe(id)
			if type(d.farm_key) ~= "string" or d.farm_key == "" then
				error(`decision {id}: farm_key missing`)
			end
			if not (d.repeat_decay > 0 and d.repeat_decay <= 1) or d.repeat_window_s < 0 then
				error(`decision {id}: repeat_decay must be in (0, 1] and repeat_window_s >= 0`)
			end
			for _, c in CATEGORIES do
				local v = d.rep[c]
				if type(v) ~= "number" or v < -10 or v > 10 then
					error(`decision {id}: rep.{c} = {tostring(v)} outside -10..10`)
				end
			end
			expect(count(d.rep)).toBe(#CATEGORIES)
			for _, bag in { d.cost, d.resources } do
				for res, n in bag do
					if not RESOURCES[res] or type(n) ~= "number" then
						error(`decision {id}: bad resource entry {tostring(res)}`)
					end
				end
			end
			for res, n in d.cost do
				if n <= 0 then
					error(`decision {id}: cost.{res} must be > 0 (amount paid)`)
				end
			end
			if d.audience ~= "none" and d.audience ~= "occupation" and d.audience ~= "kingdom" then
				error(`decision {id}: unknown audience {tostring(d.audience)}`)
			end
			for traitId in d.trait_overrides do
				if Traits[traitId] == nil then
					error(`decision {id}: trait_overrides names unknown trait {traitId}`)
				end
			end
			for _, cid in d.consequences do
				if Consequences[cid] == nil then
					error(`decision {id}: unknown consequence {cid}`)
				end
			end
			local e = ContentQuery.decisionEffects(id)
			assert(e, id)
			for _, risk in e.risks do
				expect(risk.chance).toBeLessThan(1)
			end
		end
	end)

	it("keep every consequence well-formed; no strike stops a whole kingdom (model decision 6)", function()
		for _, id in sortedKeys(Consequences) do
			local c = Consequences[id]
			expect(c.id).toBe(id)
			if not CONSEQUENCE_KINDS[c.kind] then
				error(`consequence {id}: unknown kind {tostring(c.kind)}`)
			end
			if not (c.chance > 0 and c.chance <= 1) then
				error(`consequence {id}: chance {c.chance} outside (0, 1]`)
			end
			if c.duration_s < 0 or c.delay_s < 0 then
				error(`consequence {id}: negative duration or delay`)
			end
			local occupation = string.match(c.target, "^occupation:(.+)$")
			local simple = {
				speaker = true,
				family = true,
				friends = true,
				soldiers = true,
				civilians = true,
				kingdom = true,
			}
			if not (simple[c.target] or (occupation and Occupations[occupation])) then
				error(`consequence {id}: unknown target {c.target}`)
			end
			if c.duration_s > MAX_DURATION_S then
				error(`consequence {id}: duration_s {c.duration_s} > {MAX_DURATION_S}`)
			end
			if c.kind == "strike" then
				local target = Occupations[occupation or ""]
				if target == nil or target.job == "soldier" then
					error(`consequence {id}: a strike targets one civilian occupation:<id>, not {c.target}`)
				end
				if c.magnitude > STRIKE_MAX_SHARE or c.duration_s > STRIKE_MAX_DURATION_S then
					error(`consequence {id}: a strike from one decision is at most half an occupation for 120 s`)
				end
			end
			if c.kind == "productivity" and not LOCAL_TARGETS[c.target] and c.magnitude < GROUP_PRODUCTIVITY_FLOOR then
				error(`consequence {id}: productivity {c.magnitude} on {c.target} would stop a whole group`)
			end
			if c.chance < 1 and (c.notice == nil or string.find(c.notice, "{chance}", 1, true) == nil) then
				error(`consequence {id}: a risk (chance {c.chance}) must show its odds with \{chance\}`)
			end
			if c.notice then
				local filled = ContentQuery.consequenceNotice(
					c,
					{ name = "Agnes", ruler = "Ruler", kingdom = "Kingdom", occupation = "Farmer" }
				)
				if filled == nil or string.find(filled, "{", 1, true) then
					error(`consequence {id}: notice keeps an unfilled placeholder: {tostring(filled)}`)
				end
			end
			if c.kind == "unlock_scenario" and Dialogue.scenarios[c.param] == nil then
				error(`consequence {id}: unlocks unknown scenario {tostring(c.param)}`)
			end
			if c.kind == "cue" and type(c.cue_id) ~= "string" then
				error(`consequence {id}: a cue needs cue_id`)
			end
			if c.notice and textLength(c.notice) > TEXT_LIMITS.notice then
				error(`consequence {id}: notice over its length limit`)
			end
		end
	end)
end)

describe("model decision 6: no single decision turns the kingdom", function()
	it("caps every decision's kingdom-wide loyalty and stability change", function()
		for _, id in sortedKeys(Decisions) do
			local d = Decisions[id]
			local loyalty = if d.audience == "kingdom" then d.audience_loyalty else 0
			local stability = d.kingdom.stability
			for _, cid in d.consequences do
				local c = Consequences[cid]
				if c.kind == "loyalty" and BROAD_TARGETS[c.target] then
					loyalty += c.magnitude
				elseif c.kind == "stability" then
					stability += c.magnitude
				end
			end
			if loyalty < KINGDOM_LOYALTY_FLOOR or stability < KINGDOM_STABILITY_FLOOR then
				error(`decision {id}: kingdom-wide loyalty {loyalty} / stability {stability} below the floor`)
			end
		end
	end)
end)

describe("Traits, Occupations and Names", function()
	it("give every trait six weights in -2..+2 and symmetric opposites", function()
		for _, id in sortedKeys(Traits) do
			local t = Traits[id]
			expect(t.id).toBe(id)
			for _, c in CATEGORIES do
				local w = t.weights[c]
				if type(w) ~= "number" or w < -2 or w > 2 then
					error(`trait {id}: weight {c} = {tostring(w)} outside -2..2`)
				end
			end
			if t.opposite ~= nil then
				local other = Traits[t.opposite]
				if other == nil or other.opposite ~= id or t.opposite == id then
					error(`trait {id}: opposite {t.opposite} is not symmetric`)
				end
			end
			expect(ContentQuery.loyaltyDelta({ compassion = 1, fear = 1 }, { id }, "speaker", 0)).toBeA("number")
		end
	end)

	it("map every occupation to a CONTRACTS G2 job with known trait affinities", function()
		expect(count(Occupations)).toBeGreaterThan(0)
		for _, id in sortedKeys(Occupations) do
			local o = Occupations[id]
			expect(o.id).toBe(id)
			if not JOBS[o.job] then
				error(`occupation {id}: job {tostring(o.job)} is not a CONTRACTS G2 JobId`)
			end
			for traitId, w in o.trait_affinity do
				if Traits[traitId] == nil or w < 0 or w > 5 then
					error(`occupation {id}: bad trait affinity {traitId}:{w}`)
				end
			end
			expect(o.needs).toBeA("table")
		end
	end)

	it("hold at least 60 given names and 40 family names", function()
		local given = #Names.given_f + #Names.given_m + #Names.given_n
		expect(given).toBeGreaterThanOrEqual(60)
		expect(#Names.family).toBeGreaterThanOrEqual(40)
	end)
end)

describe("Reputation", function()
	it("defines the six categories in canonical order with starts in 0..100", function()
		expect(Reputation.order).toEqual(CATEGORIES)
		expect(sortedKeys(Reputation.categories)).toEqual(sortedKeys({
			compassion = 1,
			honor = 1,
			competence = 1,
			courage = 1,
			authority = 1,
			fear = 1,
		}))
		for _, c in CATEGORIES do
			local cat = Reputation.categories[c]
			expect(cat.id).toBe(c)
			if cat.start < 0 or cat.start > 100 then
				error(`category {c}: start {cat.start} outside 0..100`)
			end
		end
	end)

	it("indexes every action by its event and keeps rep changes within -10..10", function()
		local indexed = {}
		for event, list in Reputation.byEvent do
			for _, i in list do
				local a = Reputation.actions[i]
				if a == nil or a.event ~= event then
					error(`byEvent[{event}] points at action #{i} with another event`)
				end
				indexed[i] = true
			end
		end
		for i, a in Reputation.actions do
			if not indexed[i] then
				error(`action #{i} ({a.id}) is missing from byEvent`)
			end
			for _, c in CATEGORIES do
				local v = a.rep[c]
				if type(v) ~= "number" or v < -10 or v > 10 then
					error(`action #{i} ({a.id}): rep.{c} = {tostring(v)} outside -10..10`)
				end
			end
			if not (a.repeat_decay > 0 and a.repeat_decay <= 1) then
				error(`action #{i} ({a.id}): repeat_decay outside (0, 1]`)
			end
		end
	end)

	it("lets ContentQuery fire every event and reach a listener for every row (SPEC §6.9)", function()
		local ctx = fullSampleCtx()
		for _, event in sortedKeys(Reputation.byEvent) do
			local listed = {}
			for _, i in Reputation.byEvent[event] do
				listed[Reputation.actions[i]] = true
			end
			local base = string.match(event, "^([^:]+):")
			for _, i in (if base then Reputation.byEvent[base] else nil) or {} do
				listed[Reputation.actions[i]] = true
			end
			for _, f in ContentQuery.actionFirings(event, ctx) do
				expect(#f.rows).toBeGreaterThan(0)
				for _, row in f.rows do
					if not listed[row] or row.id ~= f.id or not ContentQuery.evaluate(row.condition, ctx) then
						error(`event {event}: firing {f.id} holds a row that should not fire`)
					end
				end
			end
		end
		for i, a in Reputation.actions do
			local audience = a.audience
			if audience == nil then
				continue
			end
			local occupation = string.match(audience, "^occupation:(.+)$")
			local listener = {
				occupation = occupation or (if audience == "soldiers" then "soldier" else "farmer"),
				speaker = true,
			}
			if occupation and Occupations[occupation] == nil then
				error(`action #{i} ({a.id}): unknown audience occupation {occupation}`)
			end
			local listenerCtx, badVar = satisfyingCtx(a.audience_condition, ctx)
			if listenerCtx == nil then
				error(`action #{i} ({a.id}): no listener can satisfy {tostring(badVar)}`)
			end
			if not ContentQuery.inActionAudience(a :: any, listener, listenerCtx) then
				error(`action #{i} ({a.id}): no listener of audience {audience} hears it`)
			end
			expect(ContentQuery.actionLoyalty(a :: any, { "kind" }, 0)).toBeA("number")
		end
	end)
end)
