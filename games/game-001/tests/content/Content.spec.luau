			expect(cat.id).toBe(c)
			if cat.start < 0 or cat.start > 100 then
				error(`category {c}: start {cat.start} outside 0..100`)
			end
		end
	end)

	it("indexes every action by its event and keeps rep changes within -10..10", function()
		local indexed = {}
		for event, list in Reputation.byEvent do
			for _, i in list do
				local a = Reputation.actions[i]
				if a == nil or a.event ~= event then
					error(`byEvent[{event}] points at action #{i} with another event`)
				end
				indexed[i] = true
			end
		end
		for i, a in Reputation.actions do
			if not indexed[i] then
				error(`action #{i} ({a.id}) is missing from byEvent`)
			end
			for _, c in CATEGORIES do
				local v = a.rep[c]
				if type(v) ~= "number" or v < -10 or v > 10 then
					error(`action #{i} ({a.id}): rep.{c} = {tostring(v)} outside -10..10`)
				end
			end
			if not (a.repeat_decay > 0 and a.repeat_decay <= 1) then
				error(`action #{i} ({a.id}): repeat_decay outside (0, 1]`)
			end
		end
	end)

	it("lets ContentQuery fire every event and reach a listener for every row (SPEC §6.9)", function()
		local ctx = fullSampleCtx()
		for _, event in sortedKeys(Reputation.byEvent) do
			local listed = {}
			for _, i in Reputation.byEvent[event] do
				listed[Reputation.actions[i]] = true
			end
			local base = string.match(event, "^([^:]+):")
			for _, i in (if base then Reputation.byEvent[base] else nil) or {} do
				listed[Reputation.actions[i]] = true
			end
			for _, f in ContentQuery.actionFirings(event, ctx) do
				expect(#f.rows).toBeGreaterThan(0)
				for _, row in f.rows do
					if not listed[row] or row.id ~= f.id or not ContentQuery.evaluate(row.condition, ctx) then
						error(`event {event}: firing {f.id} holds a row that should not fire`)
					end
				end
			end
		end
		for i, a in Reputation.actions do
			local audience = a.audience
			if audience == nil then
				continue
			end
			local occupation = string.match(audience, "^occupation:(.+)$")
			local listener = {
				occupation = occupation or (if audience == "soldiers" then "soldier" else "farmer"),
				speaker = true,
			}
			if occupation and Occupations[occupation] == nil then
				error(`action #{i} ({a.id}): unknown audience occupation {occupation}`)
			end
			local listenerCtx, badVar = satisfyingCtx(a.audience_condition, ctx)
			if listenerCtx == nil then
				error(`action #{i} ({a.id}): no listener can satisfy {tostring(badVar)}`)
			end
			if not ContentQuery.inActionAudience(a :: any, listener, listenerCtx) then
				error(`action #{i} ({a.id}): no listener of audience {audience} hears it`)
			end
			expect(ContentQuery.actionLoyalty(a :: any, { "kind" }, 0)).toBeA("number")
		end
	end)

	it("decays only the gains of every action row on a repeat; losses stay whole even beside a gain", function()
		-- e.g. keep_upgraded while starving: +3 happiness and -1 happiness in one firing (model decision 5)
		local fed = fullSampleCtx()
		local starving = fullSampleCtx()
		starving["kingdom.fed_ratio"] = 0.5
		starving["kingdom.population"] = 20
		starving["event.shortage"] = true
		for _, ctx in { fed, starving } do
			for _, event in sortedKeys(Reputation.byEvent) do
				local rulers, kingdom = { a = {}, b = {} }, {}
				ContentQuery.fireAction(event, ctx, rulers, { "a" }, kingdom, 0)
				for _, f in ContentQuery.fireAction(event, ctx, rulers, { "a", "b" }, kingdom, 1) do
					local function check(field: string, key: string, got: number, multiplier: number)
						local gains, losses = 0, 0
						for _, row in f.rows do
							local v = (row :: any)[field][key] or 0
							if v > 0 then
								gains += v
							else
								losses += v
							end
						end
						if math.abs(got - (gains * multiplier + losses)) > 1e-9 then
							error(`{event} {f.id}: {field}.{key} = {got}, expected {gains} x {multiplier} + {losses}`)
						end
					end
					expect(#f.rulers).toBe(2) -- two co-rulers, each decayed by their own history
					for _, credited in f.rulers do
						for _, c in CATEGORIES do
							check("rep", c, credited.rep[c], credited.multiplier)
						end
					end
					for _, k in { "happiness", "stability", "morale" } do
						check("kingdom", k, (f.kingdom :: any)[k], f.kingdom_multiplier)
					end
				end
			end
		end
	end)

	it("bounds 30 minutes of RaidDefended at one per second by one firing / (1 - decay) (ruling #8)", function()
		local ctx = fullSampleCtx()
		local firings = ContentQuery.actionFirings("RaidDefended", ctx)
		expect(#firings).toBe(1)
		local rows = firings[1].rows
		local decay = firings[1].repeat_decay
		expect(decay < 1 and firings[1].repeat_window_s > 0).toBe(true)
		-- per firing: the gains of each row (decayed on a repeat) and its losses (never decayed)
		local gains, losses = {}, {}
		local keys = table.clone(CATEGORIES)
		for _, k in { "happiness", "stability", "morale" } do
			table.insert(keys, k)
		end
		for _, key in keys do
			gains[key], losses[key] = 0, 0
			for _, row in rows do
				local v = (row.rep :: any)[key] or (row.kingdom :: any)[key] or 0
				if v > 0 then
					gains[key] += v
				else
					losses[key] += v
				end
			end
		end
		local listeners = {
			{ citizen = 1, occupation = "farmer", traits = {}, chemistry = 0, ctx = ctx },
			{ citizen = 2, occupation = "soldier", traits = {}, chemistry = 0, ctx = ctx },
		}
		local rulers, kingdom = { ruler = {} }, {}
		local totals: { [string]: number } = {}
		local heard: { [any]: number } = {}
		local firstLoyalty: { [any]: number } = {}
		local n = 30 * 60
		for now = 0, n - 1 do
			for _, f in
				ContentQuery.fireAction("RaidDefended", ctx, rulers, { "ruler" }, kingdom, now, listeners :: any)
			do
				for key, v in f.rulers[1].rep do
					totals[key] = (totals[key] or 0) + v
				end
				for key, v in f.kingdom :: any do
					totals[key] = (totals[key] or 0) + v
				end
				for _, l in f.listeners do
					heard[l.citizen] = (heard[l.citizen] or 0) + l.loyalty
					if firstLoyalty[l.citizen] == nil then
						firstLoyalty[l.citizen] = l.loyalty
					end
				end
			end
		end
		for _, key in keys do
			local bound = gains[key] / (1 - decay) + losses[key] * n + 1e-9
			if (totals[key] or 0) > bound then
				error(`RaidDefended {key}: {totals[key]} over {n} firings exceeds the bound {bound}`)
			end
		end
		expect(totals.courage).toBeGreaterThan(0)
		-- no traits and no clamp reached: each firing is the row's column decayed, so the same bound holds
		for citizen, total in heard do
			if total > firstLoyalty[citizen] / (1 - decay) + 1e-9 then
				error(`RaidDefended listener {citizen}: loyalty {total} exceeds the bound`)
			end
		end
		expect(heard[1]).toBeGreaterThan(0)
		expect(heard[2]).toBeGreaterThan(0)
	end)
end)
