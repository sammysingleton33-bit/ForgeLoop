local T = require("../../harness/Test")
local describe, it, expect = T.describe, T.it, T.expect

local UI = "@game/StarterPlayer/StarterPlayerScripts/Forge/UI/"
local Format = require(UI .. "Format")
local Motion = require(UI .. "Motion")
local Theme = require(UI .. "Theme")
local MockEnv = require("../../mocks/MockEnv")

describe("UI/Theme (sandbox: neutral defaults)", function()
	it("resolves every token role and refuses unknown names", function()
		expect(Theme.color("ink800")).toBeA("Color3")
		expect(Theme.rarity("Legendary")).toBeA("Color3")
		expect(Theme.font("display", Enum.FontWeight.Bold)).toBeA("Font")
		expect(Theme.textSize("body")).toBe(14)
		expect(Theme.radius("md")).toEqual(UDim.new(0, 8))
		expect(Theme.space(5)).toBe(12)
		expect(Theme.TOUCH).toBe(44)
		expect(Theme.icon("nonexistent").glyph).toBe("•")
		expect(function()
			Theme.color("nope")
		end).toThrow("unknown colour")
		expect(function()
			Theme.hex("red")
		end).toThrow("#RRGGBB")
		expect(Theme.hex("#FF0000")).toEqual(Color3.fromRGB(255, 0, 0))
	end)
end)

describe("UI/Format", function()
	it("formats amounts, signs, clocks, rates and lists", function()
		expect(Format.amount(999)).toBe("999")
		expect(Format.amount(1234)).toBe("1.2k")
		expect(Format.amount(1000)).toBe("1k")
		expect(Format.amount(15300)).toBe("15k")
		expect(Format.amount(2500000)).toBe("2.5M")
		expect(Format.amount(-1500)).toBe("-1.5k")
		expect(Format.signed(-50)).toBe("−50")
		expect(Format.signed(12)).toBe("+12")
		expect(Format.signed(0)).toBe("0")
		expect(Format.clock(75)).toBe("1:15")
		expect(Format.clock(3725)).toBe("1:02:05")
		expect(Format.clock(-3)).toBe("0:00")
		expect(Format.clock(6.2)).toBe("0:07")
		expect(Format.rate(18)).toBe("+18/min")
		expect(Format.list({ "a", "b", "c" })).toBe("a, b and c")
		expect(Format.list({ "a" })).toBe("a")
		expect(Format.list({})).toBe("")
	end)
end)

describe("UI/Motion", function()
	it("applies end states at once without a usable TweenService, and runs delayed work on env time", function()
		local env = MockEnv.new({ seed = 1 })
		local motion = Motion.new(env)
		expect(motion.enabled).toBe(false) -- MockEnv's TweenService is an unmocked guard
		local frame = Instance.new("Frame")
		motion:to(frame, { BackgroundTransparency = 0.5 }, 0.3)
		expect(frame.BackgroundTransparency).toBe(0.5)
		local done = false
		motion:after(1, function()
			done = true
		end)
		env.mock:advance(0.5)
		expect(done).toBe(false)
		env.mock:advance(0.6)
		expect(done).toBe(true)
	end)
end)
