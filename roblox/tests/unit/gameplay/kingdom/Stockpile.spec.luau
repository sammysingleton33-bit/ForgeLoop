local T = require("../../../harness/Test")
local describe, it, expect = T.describe, T.it, T.expect

local Stockpile = require("@game/ReplicatedStorage/Forge/Gameplay/Kingdom/Stockpile")

local RES = { "food", "wood", "stone", "gold" }

describe("Kingdom/Stockpile", function()
	it("starts from the initial amounts and caps additions at capacity", function()
		local s = Stockpile.new(RES, { food = 90, wood = 10 }, 100)
		expect(s:get("food")).toBe(90)
		expect(s:add("food", 25, "gathered")).toBe(10)
		expect(s:get("food")).toBe(100)
		expect(s:add("food", 5)).toBe(0)
		expect(s:add("wood", 5)).toBe(5)
		expect(s:get("wood")).toBe(15)
	end)

	it("spends all of a cost or none of it", function()
		local s = Stockpile.new(RES, { wood = 50, stone = 10 }, 400)
		expect(s:spend({ wood = 40, stone = 20 }, "construction")).toBe(false)
		expect(s:get("wood")).toBe(50)
		expect(s:get("stone")).toBe(10)
		expect(s:spend({ wood = 40, stone = 10 }, "construction")).toBe(true)
		expect(s:get("wood")).toBe(10)
		expect(s:get("stone")).toBe(0)
	end)

	it("take() removes at most what is there", function()
		local s = Stockpile.new(RES, { food = 3 }, 100)
		expect(s:take("food", 2, "meal")).toBe(2)
		expect(s:take("food", 2, "meal")).toBe(1)
		expect(s:take("food", 2, "meal")).toBe(0)
		expect(s:get("food")).toBe(0)
	end)

	it("refunds floor(cost x fraction), capped by storage", function()
		local s = Stockpile.new(RES, { wood = 95 }, 100)
		local stored = s:refund({ wood = 15, stone = 7 }, 0.5)
		expect(stored).toEqual({ wood = 5, stone = 3 })
		expect(s:get("wood")).toBe(100)
		expect(s:get("stone")).toBe(3)
	end)

	it("keeps stock above a lowered capacity instead of destroying it", function()
		local s = Stockpile.new(RES, { food = 300 }, 400)
		s:setCapacity(100)
		expect(s:get("food")).toBe(300)
		expect(s:add("food", 10)).toBe(0)
	end)

	it("books every change and audits to the exact balance", function()
		local s = Stockpile.new(RES, { food = 50, wood = 50 }, 500)
		s:add("food", 30, "gathered")
		s:take("food", 4, "meal")
		s:spend({ wood = 40 }, "construction")
		s:refund({ wood = 40 }, 0.5)
		local flows = s:flows()
		expect(flows.income.gathered.food).toBe(30)
		expect(flows.income.refund.wood).toBe(20)
		expect(flows.expense.meal.food).toBe(4)
		expect(flows.expense.construction.wood).toBe(40)
		expect(s:audit()).toBe(true)
		-- flows() returns copies
		flows.income.gathered.food = 999
		expect(s:flows().income.gathered.food).toBe(30)
	end)

	it("detects a balance changed behind the ledger's back", function()
		local s = Stockpile.new(RES, { food = 10 }, 100)
		;(s :: any)._amounts.food = 11
		local ok, why = s:audit()
		expect(ok).toBe(false)
		expect(why).toContain("food")
	end)

	it("snapshot() is a copy", function()
		local s = Stockpile.new(RES, { food = 10 }, 100)
		local snap = s:snapshot()
		snap.food = 0
		expect(s:get("food")).toBe(10)
	end)

	it("errors on programming mistakes: unknown resources and bad amounts", function()
		expect(function()
			Stockpile.new(RES, { mana = 1 }, 10)
		end).toThrow("unknown resource")
		local s = Stockpile.new(RES, nil, 100)
		expect(function()
			s:add("mana", 1)
		end).toThrow("unknown resource")
		expect(function()
			s:add("food", -1)
		end).toThrow("non-negative integer")
		expect(function()
			s:add("food", 1.5)
		end).toThrow("non-negative integer")
		expect(function()
			s:add("food", 0 / 0)
		end).toThrow("non-negative integer")
		expect(function()
			s:spend({ food = math.huge })
		end).toThrow("non-negative integer")
	end)
end)
