local T = require("../../harness/Test")
local describe, it, expect = T.describe, T.it, T.expect

local Env = require("@game/ReplicatedStorage/Forge/Contracts/Env")
local MockDataStoreService = require("../../mocks/MockDataStoreService")
local MockEnv = require("../../mocks/MockEnv")

describe("MockEnv", function()
	it("provides every Env field (Env.FIELDS) plus the mock control", function()
		local env = MockEnv.new()
		for _, field in Env.FIELDS do
			expect(env[field] ~= nil).toBe(true)
		end
		for _, field in Env.FUNCTION_FIELDS do
			expect(type(env[field])).toBe("function")
		end
		expect(type(env.mock)).toBe("table")
	end)

	it("jobIds are non-empty and distinct; an empty jobId is rejected", function()
		local a, b = MockEnv.new(), MockEnv.new()
		expect(#a.jobId > 0).toBe(true)
		expect(a.jobId).never.toBe(b.jobId)
		expect(MockEnv.new({ jobId = "server-A" }).jobId).toBe("server-A")
		expect(function()
			MockEnv.new({ jobId = "" })
		end).toThrow("jobId must be a non-empty string")
	end)

	describe("virtual time", function()
		it("now/clock/serverTimeNow start at the configured time and move only with advance()", function()
			local env = MockEnv.new({ startTime = 1000 })
			expect(env.now()).toBe(1000)
			expect(env.serverTimeNow()).toBe(1000)
			local c0 = env.clock()
			env.mock:advance(2.5)
			expect(env.now()).toBe(1002)
			expect(env.serverTimeNow()).toBe(1002.5)
			expect(env.clock() - c0).toBeNear(2.5)
			env.mock:setServerTimeOffset(0.25)
			expect(env.serverTimeNow()).toBe(1002.75)
		end)

		it("wait() inside env.spawn suspends until advance() reaches it, in time order", function()
			local env = MockEnv.new()
			local order = {}
			env.spawn(function()
				env.wait(5)
				table.insert(order, "five")
			end)
			env.spawn(function()
				env.wait(1)
				table.insert(order, "one")
				env.wait(1)
				table.insert(order, "two")
			end)
			expect(order).toEqual({})
			expect(env.mock:pendingThreads()).toBe(2)
			env.mock:advance(1)
			expect(order).toEqual({ "one" })
			env.mock:advance(10)
			expect(order).toEqual({ "one", "two", "five" })
			expect(env.mock:pendingThreads()).toBe(0)
		end)

		it("wait() in the spec's own thread fast-forwards the clock (spec code never hangs)", function()
			local env = MockEnv.new({ startTime = 0 })
			local woke = false
			env.spawn(function()
				env.wait(3)
				woke = true
			end)
			env.wait(10)
			expect(env.now()).toBe(10)
			expect(woke).toBe(true)
		end)

		it("errors in env.spawn threads are recorded and reported to the running test", function()
			local env = MockEnv.new()
			local reported = {}
			local original = T.reportUnhandledError
			T.reportUnhandledError = function(message)
				table.insert(reported, message)
			end
			env.spawn(function()
				env.wait(1)
				error("autosave exploded")
			end)
			env.mock:advance(1)
			T.reportUnhandledError = original
			expect(#env.mock.threadErrors).toBe(1)
			expect(env.mock.threadErrors[1]).toContain("autosave exploded")
			expect(reported[1]).toContain("autosave exploded")
		end)
	end)

	it("random() is deterministic for a given seed", function()
		local a, b = MockEnv.new({ seed = 42 }), MockEnv.new({ seed = 42 })
		local ra, rb = a.random(), b.random()
		for _ = 1, 5 do
			expect(ra:NextInteger(1, 1000000)).toBe(rb:NextInteger(1, 1000000))
		end
		expect(a.random(7):NextNumber()).toBe(b.random(7):NextNumber())
		local n = a.random(3):NextNumber()
		expect(n >= 0 and n < 1).toBe(true)
	end)

	it("captures logs with fields and rejects unknown levels", function()
		local env = MockEnv.new()
		env.log("warn", "DataStore retry", { attempt = 2 })
		expect(env.mock.logs[1]).toEqual({ level = "warn", message = "DataStore retry", fields = { attempt = 2 } })
		expect(env.mock:hasLog("warn", "retry")).toBe(true)
		expect(env.mock:hasLog("error", "retry")).toBe(false)
		expect(function()
			env.log("verbose" :: any, "x")
		end).toThrow("unknown level")
	end)

	describe("bindToClose", function()
		it("captures handlers and runs them in parallel within the 30 s limit", function()
			local env = MockEnv.new()
			local done = {}
			env.bindToClose(function()
				env.wait(10)
				table.insert(done, "a")
			end)
			env.bindToClose(function()
				env.wait(20)
				table.insert(done, "b")
			end)
			expect(#env.mock.closeHandlers).toBe(2)
			local finished, seconds = env.mock:runBindToClose()
			expect(finished).toBe(true)
			expect(seconds).toBe(20)
			expect(done).toEqual({ "a", "b" })
		end)

		it("reports handlers that do not finish within the limit", function()
			local env = MockEnv.new()
			env.bindToClose(function()
				env.wait(45)
			end)
			local finished = env.mock:runBindToClose(30)
			expect(finished).toBe(false)
		end)

		it("is server-only", function()
			local env = MockEnv.new({ isServer = false })
			expect(function()
				env.bindToClose(function() end)
			end).toThrow("server-only")
		end)
	end)

	it("newInstance creates real instances; remotes are attached to the mock network", function()
		local env = MockEnv.new()
		local folder = env.newInstance("Folder")
		expect(typeof(folder)).toBe("Instance")
		folder.Parent = env.ReplicatedStorage
		local remote = env.newInstance("RemoteEvent")
		remote.Parent = folder
		expect(#env.mock.instances).toBe(2)
		expect(remote.OnServerEvent ~= nil).toBe(true)
	end)

	it("sharedModules(fileName) comes from the provided table (copied)", function()
		local gameplay = { { name = "Gameplay.RoundState", kind = "serverEvent" } }
		local env = MockEnv.new({ sharedModules = { Remotes = { Gameplay = gameplay } } })
		local result = env.sharedModules("Remotes")
		expect(result.Gameplay).toBe(gameplay)
		result.Extra = true
		expect(env.sharedModules("Remotes").Extra).toBeNil()
		expect(env.sharedModules("Unknown")).toEqual({})
	end)

	it("service(name) returns overrides and built-in mocks, and errors for anything else", function()
		local fakeBadges = { AwardBadge = function() end }
		local env = MockEnv.new({ services = { BadgeService = fakeBadges } })
		expect(env.service("BadgeService")).toBe(fakeBadges)
		expect(env.service("Players")).toBe(env.Players)
		expect(env.service("Teams")).toBe(env.Teams)
		expect(function()
			env.service("TextChatService")
		end).toThrow("service 'TextChatService' is not mocked")
	end)

	it("unmocked services fail loudly only when used", function()
		local env = MockEnv.new()
		local held = env.TweenService -- holding the reference is fine
		expect(function()
			held:Create()
		end).toThrow("TweenService is not mocked")
	end)

	it("two envs with distinct jobIds can share one data store (two servers)", function()
		local shared = MockDataStoreService.new()
		local serverA = MockEnv.new({ jobId = "A", services = { DataStoreService = shared } })
		local serverB = MockEnv.new({ jobId = "B", services = { DataStoreService = shared } })
		serverA.DataStoreService:GetDataStore("Profiles"):SetAsync("u_1", { lock = serverA.jobId })
		local seen = serverB.DataStoreService:GetDataStore("Profiles"):GetAsync("u_1")
		expect(seen).toEqual({ lock = "A" })
		expect(serverA.jobId).never.toBe(serverB.jobId)
	end)

	it("localPlayer sets Players.LocalPlayer for client-side specs", function()
		local env = MockEnv.new({ isServer = false, localPlayer = { userId = 9, name = "Nine" } })
		expect(env.Players.LocalPlayer.UserId).toBe(9)
		expect(env.RunService:IsClient()).toBe(true)
	end)
end)
