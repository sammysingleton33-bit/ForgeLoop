  "exceptions": [
    {
      "id": "handoff-new",
      "kind": "add-only",
      "who": "any",
      "paths": [
        "production/handoffs/**"
      ],
      "changes": [
        "A"
      ],
      "description": "Any agent may add new files under production/handoffs/. Modifying, deleting or renaming an existing handoff (M, D, R) is not covered: never edit another agent's handoff; answer with a new file."
    },
    {
      "id": "task-own-status",
      "kind": "task-status",
      "who": "task-owner",
      "paths": [
        "production/tasks/FL-*.md"
      ],
      "changes": [
        "M"
      ],
      "fields": [
        "status",
        "updated",
        "evidence",
        "blocked_by",
        "actual_h"
      ],
      "log_section": "## Log",
      "description": "The task's owner (front-matter 'owner' of the merge-base version) may modify an existing task file only in the front-matter fields status, updated, evidence, blocked_by, actual_h and by appending lines to its '## Log' section. Any other change (title, owner, requirements, body text, existing Log lines) is a violation."
    },
    {
      "id": "task-forge05-status",
      "kind": "task-status",
      "who": "forge-05",
      "paths": [
        "production/tasks/FL-*.md"
      ],
      "changes": [
        "M"
      ],
      "fields": [
        "status",
        "updated",
        "evidence",
        "blocked_by",
        "actual_h"
      ],
      "log_section": "## Log",
      "description": "FORGE-05 may make the same status/evidence/Log edit on any task file (recording a merge or acceptance)."
    },
    {
      "id": "own-status-file",
      "kind": "own-file",
      "who": "agent-in-path",
      "paths": [
        "agents/*/STATUS.md"
      ],
      "changes": [
        "A",
        "M"
      ],
      "description": "Each agent may add or edit its own agents/<id>/STATUS.md; the '*' segment is the agent id (agents/forge-01/STATUS.md -> forge-01, agents/codex/STATUS.md -> codex)."
    },
    {
      "id": "codex-intelligence",
      "kind": "rule",
      "who": "codex",
      "paths": [
        "intelligence/**",
        "prompts/**"
      ],
      "description": "Codex owns intelligence/ and prompts/. This is an ordinary ownership row (see rules), listed here so the hand-over from FORGE-00 is visible; the checker verifies the rows exist."
    }
  ]
}
