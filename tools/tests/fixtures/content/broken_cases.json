  "value": "11",
  "expect": [
   "dialogue/decisions.csv:2:12:",
   "11 is out of range (-10..10)"
  ]
 },
 {
  "name": "condition value outside the variable range",
  "file": "dialogue/scenarios.csv",
  "row": 2,
  "column": "trigger",
  "value": "kingdom.fed_ratio < 50",
  "expect": [
   "dialogue/scenarios.csv:2:3:",
   "outside the range of 'kingdom.fed_ratio' (0..1)"
  ]
 },
 {
  "name": "double equals",
  "file": "dialogue/scenarios.csv",
  "row": 4,
  "column": "trigger",
  "value": "occupation == soldier",
  "expect": [
   "dialogue/scenarios.csv:4:3:",
   "use '=' instead of '=='"
  ]
 },
 {
  "name": "unknown trait in a trigger",
  "file": "dialogue/scenarios.csv",
  "row": 4,
  "column": "trigger",
  "value": "citizen.trait.greddy",
  "expect": [
   "dialogue/scenarios.csv:4:3:",
   "unknown trait 'greddy'",
   "'greedy'"
  ]
 },
 {
  "name": "unknown decision in a trigger",
  "file": "dialogue/scenarios.csv",
  "row": 4,
  "column": "trigger",
  "value": "!decision.d_nope",
  "expect": [
   "dialogue/scenarios.csv:4:3:",
   "unknown decision 'd_nope'"
  ]
 },
 {
  "name": "OR is not supported",
  "file": "dialogue/scenarios.csv",
  "row": 4,
  "column": "trigger",
  "value": "rep.fear > 50 | rep.authority > 50",
  "expect": [
   "dialogue/scenarios.csv:4:3:",
   "only AND"
  ]
 },
 {
  "name": "citizen variable in a kingdom condition",
  "file": "reputation/actions.csv",
  "row": 2,
