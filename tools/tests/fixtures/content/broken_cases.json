  "expect": [
   "dialogue/scenarios.csv:2:3:",
   "malformed"
  ]
 },
 {
  "name": "unknown variable",
  "file": "dialogue/scenarios.csv",
  "row": 2,
  "column": "trigger",
  "value": "kingdom.fod < 50",
  "expect": [
   "dialogue/scenarios.csv:2:3:",
