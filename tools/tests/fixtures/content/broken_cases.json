  "value": "citizen.hunger > 0.5",
  "expect": [
   "reputation/actions.csv:2:3:",
   "describes a citizen"
  ]
 },
 {
  "name": "unknown consequence id",
  "file": "dialogue/decisions.csv",
  "row": 3,
