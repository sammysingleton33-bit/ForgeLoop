  "expect": [
   "dialogue/responses.csv:3:6:",
   "unknown decision 'd_ration_strikt'"
  ]
 },
 {
  "name": "over-length text",
  "file": "dialogue/scenarios.csv",
  "row": 3,
  "column": "thought_text",
